{
  "_doc": "On session start: add only active or blocked todo summaries to context; full append-only history stays on disk.",
  "hooks": {
    "SessionStart": [
      {
        "type": "command",
        "command": "bash scripts/load-active-todo-hook.sh",
        "osx": "bash scripts/load-active-todo-hook.sh",
        "linux": "bash scripts/load-active-todo-hook.sh",
        "windows": "powershell -File scripts\\load-active-todo-hook.ps1",
        "timeout": 5
      }
    ]
  }
}
